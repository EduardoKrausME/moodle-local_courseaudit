{{!
    @template local_courseaudit/activity_analyzer_button

    Buttons injected into each course activity.

    Example context (json):
    {
        "cmid": 123
    }
}}
<div class="local-courseaudit-analysis-controls"
     data-cmid="{{{cmid}}}"
     role="group"
     aria-label="{{#str}}analysis_ai_block, local_courseaudit{{/str}}">

    <div class="local-courseaudit-analysis-controls-header">
        {{#pix}}icons/openai, local_courseaudit{{/pix}}
        <span>{{#str}}analysis_ai_block, local_courseaudit{{/str}}</span>
    </div>

    <div class="local-courseaudit-analysis-controls-actions">
        <button type="button"
                class="btn btn-sm btn-primary local-courseaudit-analyze-activity-btn"
                data-cmid="{{{cmid}}}">
            {{#pix}}i/search, core{{/pix}}
            <span>{{#str}}analyze_activity, local_courseaudit{{/str}}</span>
        </button>

        <button type="button"
                class="btn btn-sm btn-outline-info local-courseaudit-latest-analysis-btn d-none"
                data-cmid="{{{cmid}}}">
            {{#pix}}i/report, core{{/pix}}
            <span class="local-courseaudit-latest-analysis-status">
                {{#str}}analysis_latest, local_courseaudit{{/str}}
            </span>
        </button>
    </div>

    <span class="local-courseaudit-latest-analysis-summary small text-muted d-none"></span>
</div>
